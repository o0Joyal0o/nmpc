<?xml version="1.0"?>
<package format="2">
  <name>nmpc_swarm_demo</name>
  <version>0.1.0</version>
  <description>
    Swarm navigation demo: 2 differential-drive robots navigate to a RViz 2D Nav Goal
    while avoiding moving obstacles and each other using NMPC (CasADi + IPOPT).
  </description>
  <maintainer email="joyal@todo.local">PBL Group</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>gazebo_ros</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>

  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>roscpp  </exec_depend>
  <exec_depend>rospy  </exec_depend>
  <exec_depend>std_msgs  </exec_depend>
  <exec_depend>geometry_msgs  </exec_depend>
  <exec_depend>nav_msgs  </exec_depend>
  <exec_depend>sensor_msgs  </exec_depend>
  <exec_depend>gazebo_msgs  </exec_depend>
  <exec_depend>xacro  </exec_depend>
  <exec_depend>rviz  </exec_depend>

  <export>
  </export>
</package>
