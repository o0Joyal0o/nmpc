<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="box_bot">

  <!--
    Simple lightweight differential-drive robot built from basic geometric
    primitives. One xacro file is shared by all robots; each spawned instance
    gets a unique robot_name so its topics sit under /<robot_name>/...
  -->

  <xacro:property name="robot_name" value="box_bot"/>
  <xacro:property name="chassis_length" value="0.30"/>
  <xacro:property name="chassis_width"  value="0.20"/>
  <xacro:property name="chassis_height" value="0.10"/>
  <xacro:property name="wheel_radius"   value="0.06"/>
  <xacro:property name="wheel_width"    value="0.03"/>
  <xacro:property name="track_width"    value="0.16"/>   <!-- distance between wheels -->
  <xacro:property name="caster_radius"  value="0.03"/>
  <xacro:property name="mass"           value="5.0"/>

  <material name="blue">
    <color rgba="0.2 0.4 1.0 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <link name="${robot_name}/base_link">
    <visual>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.08"/>
    </inertial>
  </link>

  <!-- Left wheel -->
  <link name="${robot_name}/left_wheel">
    <visual>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="${robot_name}/left_wheel_joint" type="continuous">
    <origin xyz="0 ${track_width/2} ${-chassis_height/2 - wheel_width/2}" rpy="0 0 0"/>
    <parent link="${robot_name}/base_link"/>
    <child link="${robot_name}/left_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Right wheel -->
  <link name="${robot_name}/right_wheel">
    <visual>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="${robot_name}/right_wheel_joint" type="continuous">
    <origin xyz="0 ${-track_width/2} ${-chassis_height/2 - wheel_width/2}" rpy="0 0 0"/>
    <parent link="${robot_name}/base_link"/>
    <child link="${robot_name}/right_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Passive caster wheel (sphere) -->
  <link name="${robot_name}/caster">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="${robot_name}/caster_joint" type="fixed">
    <origin xyz="${chassis_length/2} 0 ${-chassis_height/2 - caster_radius}" rpy="0 0 0"/>
    <parent link="${robot_name}/base_link"/>
    <child link="${robot_name}/caster"/>
  </joint>

  <!-- Differential drive plugin: accepts /<robot_name>/cmd_vel, publishes /<robot_name>/odom -->
  <gazebo reference="${robot_name}/base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo>
    <plugin filename="libgazebo_ros_diff_drive.so" name="gazebo_ros_diff_drive">
      <robotNamespace>/${robot_name}</robotNamespace>
      <updateRate>30</updateRate>
      <leftJoint>${robot_name}/left_wheel_joint</leftJoint>
      <rightJoint>${robot_name}/right_wheel_joint</rightJoint>
      <wheelRadius>${wheel_radius}</wheelRadius>
      <wheelSeparation>${track_width}</wheelSeparation>
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>${robot_name}/base_link</robotBaseFrame>
      <provideOdom>true</provideOdom>
    </plugin>
  </gazebo>

</robot>
