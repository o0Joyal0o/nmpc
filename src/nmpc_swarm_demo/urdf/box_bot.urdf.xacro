<?xml version="1.0"?>
<robot name="differential_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Prefix argument (e.g., "robot_0/", "robot_1/") -->
  <xacro:arg name="prefix" default=""/>

  <!-- Dummy base link (KDL workaround: root link cannot have inertia) -->
  <link name="$(eval prefix)base_footprint"/>
  <joint name="$(eval prefix)base_footprint_joint" type="fixed">
    <parent link="$(eval prefix)base_footprint"/>
    <child link="$(eval prefix)base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Link for the main body of the robot -->
  <link name="$(eval prefix)base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <!-- Correct box inertia: 0.5x0.3x0.1, mass=1.5 -->
      <!-- ixx = 1/12*m*(y^2+z^2) = 0.0125 -->
      <!-- iyy = 1/12*m*(x^2+z^2) = 0.0325 -->
      <!-- izz = 1/12*m*(x^2+y^2) = 0.0425 -->
      <inertia ixx="0.0125" ixy="0.0" ixz="0.0" iyy="0.0325" iyz="0.0" izz="0.0425"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.3 0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 0.5 1.0"/>  
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.3 0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- Left wheel -->
  <link name="$(eval prefix)left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0025" ixy="0.0" ixz="0.0" iyy="0.0025" iyz="0.0" izz="0.0025"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>  
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- Right wheel -->
  <link name="$(eval prefix)right_wheel">
    <inertial>
    <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0025" ixy="0.0" ixz="0.0" iyy="0.0025" iyz="0.0" izz="0.0025"/>
    </inertial>
    <visual>
    <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
    <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <link name="$(eval prefix)caster_wheel">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.0005"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- Joints for wheels -->
  <joint name="$(eval prefix)left_wheel_joint" type="continuous">
    <parent link="$(eval prefix)base_link"/>
    <child link="$(eval prefix)left_wheel"/>
    <origin xyz="-0.125 0.175 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>

  </joint>

  <joint name="$(eval prefix)right_wheel_joint" type="continuous">
    <parent link="$(eval prefix)base_link"/>
    <child link="$(eval prefix)right_wheel"/>
    <origin xyz="-0.125 -0.175 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>

  </joint>

  <joint name="$(eval prefix)caster_wheel_joint" type="fixed">
    <parent link="$(eval prefix)base_link"/>
    <child link="$(eval prefix)caster_wheel"/>
    <origin xyz="0.2 0.0 -0.05" rpy="0 0 0"/>
  </joint>

<gazebo>
     <plugin name="$(eval prefix)differential_drive_controller" filename="libgazebo_ros_diff_drive.so">

       <!-- Robot namespace for this robot -->
       <robotNamespace>$(eval prefix)</robotNamespace>

       <!-- Plugin update rate in Hz -->
       <updateRate>100</updateRate>

       <!-- Name of left joint, defaults to `left_joint` -->
       <leftJoint>$(eval prefix)left_wheel_joint</leftJoint>

       <!-- Name of right joint, defaults to `right_joint` -->
       <rightJoint>$(eval prefix)right_wheel_joint</rightJoint>

       <!-- The distance from the center of one wheel to the other, in meters, defaults to 0.34 m -->
       <wheelSeparation>0.35</wheelSeparation>

       <!-- Diameter of the wheels, in meters, defaults to 0.15 m -->
       <wheelDiameter>0.2</wheelDiameter>

       <!-- Wheel acceleration, in rad/s^2, defaults to 0.0 rad/s^2 -->
       <wheelAcceleration>10.0</wheelAcceleration>

       <!-- Maximum torque which the wheels can produce, in Nm, defaults to 5 Nm -->
       <wheelTorque>20</wheelTorque>

       <!-- Topic to receive geometry_msgs/Twist message commands, defaults to `cmd_vel` -->
       <commandTopic>cmd_vel</commandTopic>

       <!-- Topic to publish nav_msgs/Odometry messages, defaults to `odom` -->
       <odometryTopic>odom</odometryTopic>

       <!-- Odometry frame, defaults to `odom` -->
       <odometryFrame>odom</odometryFrame>

       <!-- Robot frame to calculate odometry from, defaults to `base_footprint` -->
       <robotBaseFrame>$(eval prefix)base_link</robotBaseFrame>

       <!-- Odometry source, 0 for ENCODER, 1 for WORLD, defaults to WORLD -->
       <odometrySource>1</odometrySource>

       <!-- Set to false to publish transforms for the wheel links, defaults to false -->
       <publishWheelTF>false</publishWheelTF>

       <!-- Set to true to publish odom->base_link TF, defaults to true -->
       <publishTf>true</publishTf>

       <!-- Set to true to publish sensor_msgs/JointState on /joint_states for the wheel joints, defaults to false -->
       <publishWheelJointState>true</publishWheelJointState>

       <!-- Set to true to swap right and left wheels, defaults to true -->
       <legacyMode>false</legacyMode>
     </plugin>
   </gazebo>

  <link name="$(eval prefix)camera_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05" />
      </geometry>
      <material name="red">
        <color rgba="0.5 0.0 0.0 1.0" />
      </material>
    </visual>
  </link>

  <joint name="$(eval prefix)camera_joint" type="fixed">
    <parent link="$(eval prefix)base_link"/>
    <child link="$(eval prefix)camera_link"/>
    <origin xyz="0.275 0.0 0.0" rpy="0 0 0"/>
  </joint>


  <gazebo reference="$(eval prefix)camera_link">
    <material>Gazebo/Red</material>
    <sensor type="camera" name="camera_sensor">
      <pose>0 0 0 0 0 0</pose>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
      <plugin name="$(eval prefix)camera_controller" filename="libgazebo_ros_camera.so">
        <always_on>true</always_on>
        <update_rate>6.0</update_rate>
      </plugin>
    </sensor>
  </gazebo>

  <joint name="$(eval prefix)laser_joint" type="fixed">
      <parent link="$(eval prefix)base_link"/>
      <child link="$(eval prefix)laser_link"/>
      <origin xyz="0.05 0 0.125" rpy="0 0 0"/>
  </joint>

  <link name="$(eval prefix)laser_link">
      <visual>
          <origin xyz="0 0 -0.05" rpy="0 0 0"/>
          <geometry>
              <cylinder radius="0.05" length="0.1"/>
          </geometry>
          <material name="red"/>
      </visual>
      <collision>
          <geometry>
              <cylinder radius="0.05" length="0.1"/>
          </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
      </inertial>
  </link>



  <gazebo reference="$(eval prefix)laser_link">
    <material>Gazebo/Red</material>
    <sensor type="ray" name="head_hokuyo_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14</min_angle>
            <max_angle>3.14</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>6.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="$(eval prefix)gazebo_ros_head_hokuyo_controller" filename="libgazebo_ros_laser.so">
        <topicName>$(eval prefix)scan</topicName>
        <frameName>$(eval prefix)laser_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="$(eval prefix)base_footprint">
      <material>Gazebo/Transparent</material>
  </gazebo>

  <gazebo reference="$(eval prefix)base_link">
      <material>Gazebo/Blue</material>
  </gazebo>

<gazebo reference="$(eval prefix)left_wheel">
      <material>Gazebo/Black</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <fdir1>1 0 0</fdir1>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>

    <gazebo reference="$(eval prefix)right_wheel">
      <material>Gazebo/Black</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <fdir1>1 0 0</fdir1>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>

    <gazebo reference="$(eval prefix)caster_wheel">
      <material>Gazebo/Black</material>
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <slip1>1.0</slip1>
      <slip2>1.0</slip2>
    </gazebo>

  <!-- IMU Sensor -->
  <link name="$(eval prefix)imu_link">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.00125" ixy="0.0" ixz="0.0" iyy="0.00125" iyz="0.0" izz="0.00125"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
    </collision>
  </link>

  <joint name="$(eval prefix)imu_joint" type="fixed">
    <origin xyz="-0.05 0.0 0.06" rpy="0.0 0.0 0.0"/>
    <parent link="$(eval prefix)base_link"/>
    <child link="$(eval prefix)imu_link"/>
    <axis xyz="0.0 0.0 0.0"/>
  </joint>

  <gazebo reference="$(eval prefix)imu_link">
    <gravity>true</gravity>
    <sensor name="$(eval prefix)imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <topic>__default_topic__</topic>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="$(eval prefix)imu_plugin">
        <topicName>imu</topicName>
        <bodyName>$(eval prefix)imu_link</bodyName>
        <updateRateHZ>10.0</updateRateHZ>
        <gaussianNoise>0.0</gaussianNoise>
        <xyzOffset>0 0 0</xyzOffset>
        <rpyOffset>0 0 0</rpyOffset>
        <frameName>$(eval prefix)imu_link</frameName>
        <initialOrientationAsReference>false</initialOrientationAsReference>
      </plugin>
      <pose>0 0 0 0 0 0</pose>
    </sensor>
  </gazebo>

</robot>
