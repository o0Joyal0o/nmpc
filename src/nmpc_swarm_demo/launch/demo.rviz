Panels:
  - Class: rviz/Displays
    Help Height: 100
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Grid1
        - /TF1
        - /RobotModel1
        - /robot_0 path1
        - /robot_1 path1
        - /Moving obstacles1
        - /robot_0 laser1
        - /robot_1 laser1
        - /robot_0 global costmap1
      Splitter Ratio: 0.5394198894500732
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Nav Goal1
    Name: Tool Properties
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
  - Class: rviz/Time
    Name: Time
  - Class: rviz/Help
    Name: Help
Preferences:
  Save All On Exit: false
  Default Topic: ''
  Default Service: ''
  Panels:
    - Class: rviz/Displays
      Name: Displays
    - Class: rviz/Selection
      Name: Selection
    - Class: rviz/Tool Properties
      Name: Tool Properties
    - Class: rviz/Views
      Name: Views
    - Class: rviz/Time
      Name: Time
    - Class: rviz/Help
      Name: Help
Toolbars:
  - Class: rviz/ToolToolBar
  - Class: rviz/NavigateToolBar
Visualization Manager:
  Class: ''
  Displays:
    - Class: rviz/Grid
      Cell Size: 1
      Color: 165; 165; 165; 127
      Enabled: true
      Line Style: Billboards
      Name: Grid
      Plane: XY
      Plane Cell Count: 10
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 10
      Frames:
        Enabled: true
      Marker Scale: 1
      Name: TF
      Show Axes: true
      Show Names: true
      Tree:
        robot_0/base_link:
          robot_0/base_link:
        robot_1/base_link:
          robot_1/base_link:
      Update Interval: 0
      Value: true
    - Class: rviz/RobotModel
      Name: RobotModel
      Robot Description: robot_0/robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      TF Prefix: robot_0
      Value: true
      Enabled: true
    - Class: rviz/RobotModel
      Name: RobotModel 2
      Robot Description: robot_1/robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      TF Prefix: robot_1
      Value: true
      Enabled: true
    - Class: rviz/Path
      Color: 0; 255; 0
      Enabled: true
      Line Style: Billboards
      Name: robot_0 path
      Radius: 0.02
      Topic: /robot_0/path
    - Class: rviz/Path
      Color: 255; 0; 0
      Enabled: true
      Line Style: Billboards
      Name: robot_1 path
      Radius: 0.02
      Topic: /robot_1/path
    - Class: rviz/PoseArray
      Color: 255; 128; 0
      Enabled: true
      Name: Moving obstacles
      Radius: 0.3
      Shape: Sphere
      Topic: /moving_obstacles
    - Class: rviz/LaserScan
      Alpha: 0.5
      Color: 255; 255; 0
      Enabled: true
      Name: robot_0 laser
      Queue Size: 10
      Topic: /robot_0/robot_0/scan
      Value: true
      Style: Lines
      Line Width: 0.02
    - Class: rviz/LaserScan
      Alpha: 0.5
      Color: 255; 0; 255
      Enabled: true
      Name: robot_1 laser
      Queue Size: 10
      Topic: /robot_1/robot_1/scan
      Value: true
      Style: Lines
      Line Width: 0.02
    - Class: rviz/Map
      Alpha: 0.7
      Color Scheme: costmap
      Enabled: false
      Name: robot_0 local costmap
      Topic: /robot_0/local_costmap
      Value: true
    - Class: rviz/Map
      Alpha: 0.5
      Color Scheme: costmap
      Enabled: false
      Name: robot_1 local costmap
      Topic: /robot_1/local_costmap
      Value: true
    - Class: rviz/Map
      Alpha: 0.7
      Color Scheme: costmap
      Enabled: true
      Name: robot_0 global costmap
      Topic: /robot_0/global_costmap
      Value: true
    - Class: rviz/Map
      Alpha: 0.5
      Color Scheme: costmap
      Enabled: false
      Name: robot_1 global costmap
      Topic: /robot_1/global_costmap
      Value: true
  Enabled: true
  Fixed Frame: map
  Name: Visualization Manager
  Notes: ''
  Status: []
  Tree: ''
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: false
    - Class: rviz/MoveCamera
      Hide Inactive Objects: false
    - Class: rviz/Select
      Hide Inactive Objects: false
    - Class: rviz/FocusCamera
      Hide Inactive Objects: false
    - Class: rviz/Measure
      Hide Inactive Objects: false
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Value: true
  Views:
    Current:
      Class: rviz/XYOrbit
      Distance: 12
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.2
      Target Frame: <Fixed Frame>
      Value: XYOrbit (rviz/XYOrbit)
      Yaw: 0
    Saved: ~
Background Color: 48; 48; 48
Default Grid: rviz/Grid
Background Color: 48; 48; 48
Default Grid: rviz/Grid
Window Geometry:
  Height: 768
  Width: 1024
  X: 0
  Y: 0
