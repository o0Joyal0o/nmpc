<launch>
  <!--
    nmpc_swarm_demo demo.launch
    Launches Gazebo Classic with an empty ground plane, spawns two
    box_bot differential-drive robots (robot_0 at (0,0), robot_1 at (0,1)),
    starts the moving obstacles node and the single central NMPC controller,
    and opens RViz with pre-configured displays.
  -->

  <!-- Gazebo Classic with an empty ground plane -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
  </include>

  <!-- Robot 0: spawn with namespace robot_0 -->
  <group ns="robot_0">
    <param name="robot_description"
           command="$(find xacro)/xacro $(find nmpc_swarm_demo)/urdf/box_bot.urdf.xacro prefix:=robot_0/"/>
    <node pkg="nmpc_swarm_demo" type="spawn_robot.sh" name="spawn" output="screen"
          args="robot_0 robot_description 0 0 0 0"/>
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="rsp"
          output="screen">
      <param name="publish_frequency" value="30.0"/>
    </node>
  </group>

  <!-- Robot 1: spawn with namespace robot_1 -->
  <group ns="robot_1">
    <param name="robot_description"
           command="$(find xacro)/xacro $(find nmpc_swarm_demo)/urdf/box_bot.urdf.xacro prefix:=robot_1/"/>
    <node pkg="nmpc_swarm_demo" type="spawn_robot.sh" name="spawn" output="screen"
          args="robot_1 robot_description 0 1 0 0"/>
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="rsp"
          output="screen">
      <param name="publish_frequency" value="30.0"/>
    </node>
  </group>

  <!-- Moving obstacles (publishes /moving_obstacles PoseArray) -->
  <node pkg="nmpc_swarm_demo" type="moving_obstacles.py" name="moving_obstacles"
        output="screen"/>

  <!-- Costmaps for each robot (global + local) -->
  <node pkg="nmpc_swarm_demo" type="simple_costmap.py" name="costmap_robot_0" output="screen">
    <param name="robot_name" value="robot_0"/>
    <param name="resolution" value="0.05"/>
    <param name="global_size_x" value="20.0"/>
    <param name="global_size_y" value="20.0"/>
    <param name="local_size_x" value="6.0"/>
    <param name="local_size_y" value="6.0"/>
    <param name="inflation_radius" value="0.4"/>
    <param name="static_obstacles" value="[[1.5, 0.5], [-1.0, -1.0]]"/>
  </node>

  <node pkg="nmpc_swarm_demo" type="simple_costmap.py" name="costmap_robot_1" output="screen">
    <param name="robot_name" value="robot_1"/>
    <param name="resolution" value="0.05"/>
    <param name="global_size_x" value="20.0"/>
    <param name="global_size_y" value="20.0"/>
    <param name="local_size_x" value="6.0"/>
    <param name="local_size_y" value="6.0"/>
    <param name="inflation_radius" value="0.4"/>
    <param name="static_obstacles" value="[[1.5, 0.5], [-1.0, -1.0]]"/>
  </node>

  <!-- Single central NMPC controller for both robots -->
  <node pkg="nmpc_swarm_demo" type="central_controller.py" name="central_controller"
        output="screen">
    <param name="static_obstacles" value="[[1.5, 0.5], [-1.0, -1.0]]"/>
    <!-- Improved NMPC parameters: cruise control, inverse barriers, symmetry-breaking heading -->
    <param name="dt" value="0.033"/>               <!-- 30 Hz discretization -->
    <param name="horizon" value="15"/>             <!-- 0.5s horizon at 30Hz -->
    <param name="ctrl_rate" value="30.0"/>        <!-- 30 Hz control loop -->
    <param name="v_max" value="1.0"/>             <!-- 1 m/s max speed -->
    <param name="v_min" value="-0.8"/>            <!-- reverse speed almost same as forward -->
    <param name="w_max" value="2.5"/>             <!-- faster turning -->
    <param name="formation_offset" value="0.5"/>  <!-- 0.5m lateral separation -->
    <param name="d_min" value="0.6"/>             <!-- inter-robot 0.6m -->
    <param name="d_obs_min" value="0.5"/>        <!-- obstacle warning radius 0.5m (was 0.35) -->
    <param name="w_pos" value="20.0"/>            <!-- position tracking -->
    <param name="w_theta" value="5.0"/>           <!-- heading tracking (sin^2) -->
    <param name="w_cruise" value="15.0"/>         <!-- cruise control: penalize not at v_max -->
    <param name="R_v" value="0.05"/>              <!-- small velocity regularization -->
    <param name="R_dv" value="0.3"/>              <!-- linear accel smoothness -->
    <param name="R_domega" value="1.0"/>          <!-- angular accel smoothness -->
    <param name="w_avoid" value="50.0"/>          <!-- inverse barrier: obstacles (MUCH higher for pure inverse) -->
    <param name="w_avoid_robot" value="12.0"/>    <!-- inverse barrier: inter-robot -->
    <param name="odom_max_age" value="0.3"/>      <!-- fresher odom required -->
    <!-- Arrival detection: per-robot stop at goal -->
    <param name="arrival_dist" value="0.15"/>       <!-- position tolerance [m] -->
    <param name="arrival_angle" value="0.2"/>       <!-- heading tolerance [rad] -->
    <param name="arrival_hold_time" value="0.5"/>   <!-- hold time before declaring arrived [s] -->
  </node>

  <!-- RViz with pre-configured displays -->
  <node pkg="rviz" type="rviz" name="rviz" output="screen"
        args="-d $(find nmpc_swarm_demo)/launch/demo.rviz"/>
</launch>
