<launch>
  <!--
    nmpc_swarm_demo demo.launch
    -----------------------------
    Launches Gazebo Classic with an empty ground plane, spawns two
    box_bot differential-drive robots (robot_0 at (0,0), robot_1 at (0,1)),
    starts the moving obstacles node and the single central NMPC controller,
    and opens RViz with pre-configured displays.

    Design notes (kept minimal for a college PBL demo):
      * No ROS namespaces (no ns="..." tags or remapping groups).
      * Robot topics are explicit: /robot_0/cmd_vel, /robot_0/odom, ...
      * ONE central controller node handles both robots in a `for` loop.
  -->

  <!-- Gazebo Classic with an empty ground plane -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
  </include>

  <!-- Robot description (xacro) for robot_0; used by robot_state_publisher for RViz -->
  <param name="robot_description"
         command="xacro --inorder $(find nmpc_swarm_demo)/urdf/box_bot.urdf.xacro robot_name:=robot_0"/>

  <!-- Publish the robot model TF so RViz can render robot_0's box_bot model -->
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"
        output="screen"/>

  <!-- Spawn robot_0 at (0, 0) -->
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_robot_0" output="screen"
        args="-param robot_description -model robot_0 -x 0 -y 0 -z 0 -Y 0"/>

  <!-- Spawn robot_1 at (0, 1). Re-process the xacro with robot_name:=robot_1. -->
  <param name="robot_description_1"
         command="xacro --inorder $(find nmpc_swarm_demo)/urdf/box_bot.urdf.xacro robot_name:=robot_1"/>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_robot_1" output="screen"
        args="-param robot_description_1 -model robot_1 -x 0 -y 1 -z 0 -Y 0"/>

  <!-- Moving obstacles (publishes /moving_obstacles PoseArray) -->
  <node pkg="nmpc_swarm_demo" type="moving_obstacles.py" name="moving_obstacles"
        output="screen"/>

  <!-- Single central NMPC controller for both robots -->
  <node pkg="nmpc_swarm_demo" type="central_controller.py" name="central_controller"
        output="screen"/>

  <!-- RViz with pre-configured displays -->
  <node pkg="rviz" type="rviz" name="rviz" output="screen"
        args="-d $(find nmpc_swarm_demo)/launch/demo.rviz"/>
</launch>
